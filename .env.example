APP_NAME=SI-KOPMA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_kopma
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Chatbot AI KOPMA MART (kosongkan OPENAI_API_KEY = chatbot pakai mode database)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Nomor WA bisnis resmi KOPMA MART (format internasional, contoh 6281234567890).
# Semua tombol "Pesan via WA" / "Bagikan struk" memakai nomor ini (https://wa.me/<nomor>).
WA_BUSINESS_NUMBER=
WA_BUSINESS_NAME=KOPMA MART
